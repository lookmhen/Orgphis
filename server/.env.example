# Server Configuration
PORT=3000

# SQLite Database Location
# - Local Node development (inside server/): "file:../../data/phishcentral.db"
# - Docker deployment: "file:/app/data/phishcentral.db"
DATABASE_URL="file:../../data/phishcentral.db"

# Admin API Key for external integrations / security controls
ADMIN_API_KEY="your-secure-admin-api-key"

# Base URL for Phishing Links & Tracking Pixels
# - Leave blank ("") to let PhishCentral automatically detect host LAN IP
# - Or specify custom domain for production: "https://phish.yourcompany.com"
BASE_URL=""

# ============================================================================
# Authentication & Session Security (Production Ready)
# ============================================================================
# Secret key for signing JWT Access & Refresh Tokens (Use 64+ random hex chars)
JWT_SECRET="replace-with-strong-64-char-random-hex-secret-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Administrator Account (Seeded automatically on first boot only)
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="PhishCentral@2026"
ADMIN_DEFAULT_DISPLAY_NAME="System Administrator"
