# Server Configuration
PORT=3000

# SQLite Database Location
# - Local Node development (inside server/): "file:../../data/phishcentral.db"
# - Docker deployment: "file:/app/data/phishcentral.db"
DATABASE_URL="file:../../data/phishcentral.db"

# Admin API Key for external integrations / security controls
ADMIN_API_KEY="your-secure-admin-api-key"

# Base URL for Phishing Links & Tracking Pixels
# - Leave blank ("") to let PhishCentral automatically detect host LAN IP
# - Or specify custom domain for production: "https://phish.yourcompany.com"
BASE_URL=""
